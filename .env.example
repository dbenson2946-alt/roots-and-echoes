# Copy this file to .env.local (for local dev) and set the same three
# variables in your Vercel project's Settings -> Environment Variables
# for the deployed app.

# Supabase project settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase project settings -> API -> Publishable key (starts with sb_publishable_)
# This is safe to expose in client-side code — it only ever operates within
# the row-level security rules defined in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The app's own public URL. Used to build the magic-link email's redirect
# target (so clicking the link in the email sends the user back to the
# right place). http://localhost:3000 for local dev; your real
# https://your-app.vercel.app (or custom domain) once deployed.
# Deliberately NOT prefixed with NEXT_PUBLIC_ — it's only read on the
# server (in a Server Action), never in browser code, so there's no reason
# to expose it to the client bundle.
SITE_URL=http://localhost:3000
